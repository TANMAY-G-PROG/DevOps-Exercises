pipeline {
    agent any

    stages {

        stage('Pre-check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker info'
                echo 'Docker is available and running.'
            }
        }

        stage('Build Delivery Metrics Image') {
            steps {
                sh '''
                    docker rm -f delivery_metrics 2>/dev/null || true
                    docker build -t delivery_metrics .
                '''
            }
        }

        stage('Run Delivery Metrics') {
            steps {
                sh '''
                    docker run -d \
                      --name delivery_metrics \
                      -p 8000:8000 \
                      delivery_metrics
                '''
            }
        }

        stage('Verify Application') {
            steps {
                sh '''
                    sleep 5
                    docker ps --filter "name=delivery_metrics"
                    docker logs delivery_metrics --tail 10
                '''
            }
        }

        stage('Verify Monitoring Stack') {
            steps {
                sh '''
                    docker ps --filter "name=prometheus"
                    docker ps --filter "name=grafana"
                '''
            }
        }
    }

    post {
        success {
            echo 'Delivery monitoring pipeline completed successfully!'
        }

        failure {
            echo 'Delivery monitoring pipeline failed.'
        }
    }
}
